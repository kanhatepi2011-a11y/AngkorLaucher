<?xml version="1.0" encoding="utf-8"?>
<com.movtery.angkorlauncher.ui.layout.AnimConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_account_section"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_48sdp"
    android:paddingHorizontal="@dimen/_8sdp"
    app:ripple_for_constraint="true">

    <ImageView
        android:id="@+id/user_icon"
        android:layout_width="@dimen/launcher_avatar_size"
        android:layout_height="@dimen/launcher_avatar_size"
        android:contentDescription="@string/launcher_account_profile"
        android:scaleType="centerInside"
        android:src="@drawable/angkor_launcher_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:ellipsize="end"
        android:includeFontPadding="true"
        android:maxLines="1"
        android:textColor="@color/launcher_text_primary"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/account_type"
        app:layout_constraintEnd_toStartOf="@id/account_status_icon"
        app:layout_constraintStart_toEndOf="@id/user_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Sok Phal" />

    <TextView
        android:id="@+id/account_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:ellipsize="end"
        android:includeFontPadding="true"
        android:maxLines="1"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/account_status_icon"
        app:layout_constraintStart_toEndOf="@id/user_icon"
        app:layout_constraintTop_toBottomOf="@id/user_name"
        tools:text="Microsoft" />

    <ImageView
        android:id="@+id/account_status_icon"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginStart="@dimen/_3sdp"
        android:contentDescription="@string/launcher_account_verified"
        android:src="@drawable/ic_crown"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/user_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/user_name"
        tools:visibility="visible" />

</com.movtery.angkorlauncher.ui.layout.AnimConstraintLayout>
