<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context="com.movtery.angkorlauncher.ui.fragment.SettingsFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/settings_content_end_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.70" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/settings_info_start_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.68" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/settings_viewpager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/settings_section_gap"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settings_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/settings_tooltip"
        android:layout_width="0dp"
        android:layout_height="@dimen/settings_tooltip_height"
        android:layout_marginStart="@dimen/settings_section_half_gap"
        android:layout_marginEnd="@dimen/settings_section_gap"
        android:layout_marginTop="@dimen/settings_tooltip_top_offset"
        android:background="@drawable/settings_tooltip_glass"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="true"
        android:lineSpacingExtra="2dp"
        android:maxLines="1"
        android:maxWidth="@dimen/settings_tooltip_max_width"
        android:minWidth="104dp"
        android:paddingHorizontal="@dimen/settings_tooltip_horizontal_padding"
        android:text="@string/setting_category_video"
        android:textColor="@color/renderer_tooltip_text"
        android:textSize="@dimen/_10ssp"
        android:visibility="gone"
        app:layout_constraintWidth_max="@dimen/settings_tooltip_max_width"
        app:layout_constraintEnd_toStartOf="@id/settings_layout"
        app:layout_constraintStart_toStartOf="@id/settings_info_start_guide"
        app:layout_constraintTop_toTopOf="@id/settings_layout"
        app:layout_constraintVertical_bias="0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settings_layout"
        android:layout_width="@dimen/settings_toolbar_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/settings_toolbar_margin_end"
        android:background="@drawable/settings_rail_glass"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:padding="@dimen/settings_toolbar_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/settings_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tab_draw_indicator="false"
            app:tab_orientation="VERTICAL">

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/video_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_toolbar_item_size"
                android:background="@drawable/settings_rail_item"
                android:clickable="true"
                android:contentDescription="@string/setting_category_video"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                app:ripple_for_relative="true">

                <ImageView
                    android:id="@+id/video_image"
                    android:layout_width="@dimen/settings_toolbar_icon_size"
                    android:layout_height="@dimen/settings_toolbar_icon_size"
                    android:layout_centerInParent="true"
                    android:clickable="false"
                    android:contentDescription="@string/setting_category_video"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_setting_video"
                    app:tint="@color/renderer_text_primary" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/controls_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_toolbar_item_size"
                android:layout_marginTop="@dimen/settings_toolbar_item_gap"
                android:background="@drawable/settings_rail_item"
                android:clickable="true"
                android:contentDescription="@string/setting_category_control"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                app:ripple_for_relative="true">

                <ImageView
                    android:id="@+id/controls_image"
                    android:layout_width="@dimen/settings_toolbar_icon_size"
                    android:layout_height="@dimen/settings_toolbar_icon_size"
                    android:layout_centerInParent="true"
                    android:clickable="false"
                    android:contentDescription="@string/setting_category_control"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_menu_custom_controls"
                    app:tint="@color/renderer_text_primary" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/game_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_toolbar_item_size"
                android:layout_marginTop="@dimen/settings_toolbar_item_gap"
                android:background="@drawable/settings_rail_item"
                android:clickable="true"
                android:contentDescription="@string/setting_category_game"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                app:ripple_for_relative="true">

                <ImageView
                    android:id="@+id/game_image"
                    android:layout_width="@dimen/settings_toolbar_icon_size"
                    android:layout_height="@dimen/settings_toolbar_icon_size"
                    android:layout_centerInParent="true"
                    android:clickable="false"
                    android:contentDescription="@string/setting_category_game"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_setting_game"
                    app:tint="@color/renderer_text_primary" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/launcher_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_toolbar_item_size"
                android:layout_marginTop="@dimen/settings_toolbar_item_gap"
                android:background="@drawable/settings_rail_item"
                android:clickable="true"
                android:contentDescription="@string/setting_category_launcher"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                app:ripple_for_relative="true">

                <ImageView
                    android:id="@+id/launcher_image"
                    android:layout_width="@dimen/settings_toolbar_icon_size"
                    android:layout_height="@dimen/settings_toolbar_icon_size"
                    android:layout_centerInParent="true"
                    android:clickable="false"
                    android:contentDescription="@string/setting_category_launcher"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_setting_launcher"
                    app:tint="@color/renderer_text_primary" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/experimental_settings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_toolbar_item_size"
                android:layout_marginTop="@dimen/settings_toolbar_item_gap"
                android:background="@drawable/settings_rail_item"
                android:clickable="true"
                android:contentDescription="@string/setting_category_experimental"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                app:ripple_for_relative="true">

                <ImageView
                    android:id="@+id/experimental_image"
                    android:layout_width="@dimen/settings_toolbar_icon_size"
                    android:layout_height="@dimen/settings_toolbar_icon_size"
                    android:layout_centerInParent="true"
                    android:clickable="false"
                    android:contentDescription="@string/setting_category_experimental"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_setting_experimental"
                    app:tint="@color/renderer_text_primary" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

        </com.angcyo.tablayout.DslTabLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
