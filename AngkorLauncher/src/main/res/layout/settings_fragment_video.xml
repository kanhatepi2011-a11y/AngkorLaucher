<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/renderer_main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    tools:ignore="UseSwitchCompatOrMaterialXml">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_page_margin_horizontal"
        android:orientation="vertical"
        android:paddingVertical="@dimen/settings_page_padding_vertical">

<androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/video_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/renderer_panel_glass"
            android:orientation="vertical"
            android:padding="@dimen/renderer_panel_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/renderer_header_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/setting_renderer_title"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_setting_launcher"
                    app:tint="@color/launcher_accent_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/setting_renderer_title"
                    android:textColor="@color/launcher_accent_gold"
                    android:textSize="@dimen/_14ssp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/renderer_card_gap"
                android:background="@color/renderer_divider" />

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/renderer_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/renderer_card_min_height"
                android:background="@drawable/renderer_card_glass"
                android:focusable="true"
                android:padding="@dimen/renderer_card_padding">

                <FrameLayout
                    android:id="@+id/renderer_icon_box"
                    android:layout_width="@dimen/renderer_icon_box_size"
                    android:layout_height="@dimen/renderer_icon_box_size"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/renderer_icon_glass"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/setting_renderer_title"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_setting_launcher"
                        app:tint="@color/renderer_text_primary" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/renderer_download"
                    android:layout_width="@dimen/renderer_action_size"
                    android:layout_height="@dimen/renderer_action_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/renderer_action_button"
                    android:contentDescription="@string/setting_category_download"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/renderer_text_primary" />

                <TextView
                    android:id="@+id/renderer_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/renderer_download"
                    android:layout_toEndOf="@id/renderer_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="@string/setting_renderer_title"
                    android:textColor="@color/renderer_text_primary"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/renderer_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/renderer_title"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/renderer_download"
                    android:layout_toEndOf="@id/renderer_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:text="@string/generic_default"
                    android:textColor="@color/renderer_text_secondary"
                    android:textSize="@dimen/_14ssp"
                    tools:text="GL4ES" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/renderer_local_import_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/renderer_card_gap"
                android:minHeight="@dimen/renderer_plugin_card_min_height"
                android:background="@drawable/renderer_card_glass"
                android:focusable="true"
                android:padding="@dimen/renderer_card_padding">

                <FrameLayout
                    android:id="@+id/renderer_plugin_icon_box"
                    android:layout_width="@dimen/renderer_icon_box_size"
                    android:layout_height="@dimen/renderer_icon_box_size"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/renderer_icon_glass"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/setting_renderer_local_import_title"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/renderer_plugin_puzzle"
                        app:tint="@color/renderer_text_primary" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/renderer_local_import_manage"
                    android:layout_width="@dimen/renderer_action_size"
                    android:layout_height="@dimen/renderer_action_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/renderer_action_button"
                    android:contentDescription="@string/setting_renderer_local_manage"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/ic_setting"
                    app:tint="@color/renderer_text_primary" />

                <TextView
                    android:id="@+id/renderer_local_import_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/renderer_local_import_manage"
                    android:layout_toEndOf="@id/renderer_plugin_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="1"
                    android:text="@string/setting_renderer_local_import_title"
                    android:textColor="@color/renderer_text_primary"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/renderer_plugin_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/renderer_local_import_title"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/renderer_local_import_manage"
                    android:layout_toEndOf="@id/renderer_plugin_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:text="@string/setting_renderer_plugin_launcher_name"
                    android:textColor="@color/renderer_text_secondary"
                    android:textSize="@dimen/_11ssp" />

                <TextView
                    android:id="@+id/renderer_local_import_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/renderer_plugin_name"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/renderer_local_import_manage"
                    android:layout_toEndOf="@id/renderer_plugin_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:text="@string/setting_renderer_local_import_desc"
                    android:textColor="@color/renderer_text_secondary"
                    android:textSize="@dimen/_9ssp" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/driver_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/renderer_card_gap"
                android:minHeight="@dimen/renderer_card_min_height"
                android:background="@drawable/renderer_card_glass"
                android:focusable="true"
                android:padding="@dimen/renderer_card_padding">

                <FrameLayout
                    android:id="@+id/renderer_driver_icon_box"
                    android:layout_width="@dimen/renderer_icon_box_size"
                    android:layout_height="@dimen/renderer_icon_box_size"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/renderer_icon_glass"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/setting_driver_title"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/renderer_vulkan"
                        app:tint="@color/renderer_text_primary" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/driver_download"
                    android:layout_width="@dimen/renderer_action_size"
                    android:layout_height="@dimen/renderer_action_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/renderer_action_button"
                    android:contentDescription="@string/setting_category_download"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/renderer_text_primary" />

                <TextView
                    android:id="@+id/driver_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/driver_download"
                    android:layout_toEndOf="@id/renderer_driver_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="@string/setting_driver_title"
                    android:textColor="@color/renderer_text_primary"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/driver_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/driver_title"
                    android:layout_marginStart="@dimen/renderer_text_gap"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/renderer_text_gap"
                    android:layout_toStartOf="@id/driver_download"
                    android:layout_toEndOf="@id/renderer_driver_icon_box"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:maxLines="1"
                    android:text="@string/generic_default"
                    android:textColor="@color/renderer_text_secondary"
                    android:textSize="@dimen/_14ssp"
                    tools:text="Turnip" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Renderer options now use the full content width below the primary renderer panel. -->
        <FrameLayout
            android:id="@+id/renderer_info_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_page_section_gap">

<androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/advanced_video_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/renderer_panel_glass"
            android:orientation="vertical"
            android:padding="@dimen/renderer_panel_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="@dimen/renderer_card_gap"
                android:includeFontPadding="true"
                android:text="@string/setting_category_video"
                android:textColor="@color/launcher_accent_gold"
                android:textSize="@dimen/_12ssp" />

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/ignoreNotch_layout"
                style="@style/RendererSecondaryCard">

                <TextView
                    android:id="@+id/ignoreNotch_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/ignoreNotch"
                    android:text="@string/setting_ignore_notch_title" />

                <TextView
                    android:id="@+id/ignoreNotch_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/ignoreNotch_title"
                    android:layout_toStartOf="@id/ignoreNotch"
                    android:text="@string/setting_ignore_notch_desc" />

                <Switch
                    android:id="@+id/ignoreNotch"
                    style="@style/RendererSettingSwitch"
                    android:checked="true" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/ignoreNotchLauncher_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/ignoreNotchLauncher_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/ignoreNotchLauncher"
                    android:text="@string/setting_launcher_ignore_notch_title" />

                <TextView
                    android:id="@+id/ignoreNotchLauncher_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/ignoreNotchLauncher_title"
                    android:layout_toStartOf="@id/ignoreNotchLauncher"
                    android:text="@string/setting_launcher_ignore_notch_desc" />

                <Switch
                    android:id="@+id/ignoreNotchLauncher"
                    style="@style/RendererSettingSwitch"
                    android:checked="true" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/resolutionRatio_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/resolutionRatio_title"
                    style="@style/RendererSettingTitle"
                    android:layout_alignParentEnd="true"
                    android:text="@string/setting_resolution_scaler_title" />

                <TextView
                    android:id="@+id/resolutionRatio_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/resolutionRatio_title"
                    android:layout_alignParentEnd="true"
                    android:text="@string/setting_resolution_scaler_desc" />

                <SeekBar
                    android:id="@+id/resolutionRatio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/resolutionRatio_summary"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="4dp"
                    android:layout_toStartOf="@id/resolutionRatio_preview"
                    android:max="300"
                    android:min="25"
                    android:progressTint="@color/launcher_accent_gold"
                    android:thumbTint="@color/launcher_accent_gold" />

                <TextView
                    android:id="@+id/resolutionRatio_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/resolutionRatio"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/resolutionRatio_value"
                    android:background="@drawable/background_text"
                    android:padding="6dp"
                    android:textColor="@color/renderer_text_secondary"
                    tools:text="1920 x 1080" />

                <TextView
                    android:id="@+id/resolutionRatio_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBottom="@id/resolutionRatio"
                    android:background="@drawable/background_text"
                    android:padding="6dp"
                    android:textColor="@color/renderer_text_secondary"
                    tools:text="100" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/sustainedPerformance_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/sustainedPerformance_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/sustainedPerformance"
                    android:text="@string/setting_sustained_performance_title" />

                <TextView
                    android:id="@+id/sustainedPerformance_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/sustainedPerformance_title"
                    android:layout_toStartOf="@id/sustainedPerformance"
                    android:text="@string/setting_limit_overheating_throttling" />

                <Switch
                    android:id="@+id/sustainedPerformance"
                    style="@style/RendererSettingSwitch" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/alternate_surface_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/alternate_surface_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/alternate_surface"
                    android:text="@string/setting_use_surface_view_title" />

                <TextView
                    android:id="@+id/alternate_surface_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/alternate_surface_title"
                    android:layout_toStartOf="@id/alternate_surface"
                    android:text="@string/setting_use_surface_view_desc" />

                <Switch
                    android:id="@+id/alternate_surface"
                    style="@style/RendererSettingSwitch" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/force_vsync_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/force_vsync_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/force_vsync"
                    android:text="@string/setting_force_vsync_title" />

                <TextView
                    android:id="@+id/force_vsync_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/force_vsync_title"
                    android:layout_toStartOf="@id/force_vsync"
                    android:text="@string/setting_limit_overheating_throttling" />

                <Switch
                    android:id="@+id/force_vsync"
                    style="@style/RendererSettingSwitch" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/vsync_in_zink_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/vsync_in_zink_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/vsync_in_zink"
                    android:text="@string/setting_vsync_in_zink_title" />

                <TextView
                    android:id="@+id/vsync_in_zink_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/vsync_in_zink_title"
                    android:layout_toStartOf="@id/vsync_in_zink"
                    android:text="@string/setting_vsync_in_zink_desc" />

                <Switch
                    android:id="@+id/vsync_in_zink"
                    style="@style/RendererSettingSwitch" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>

            <com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/zinkPreferSystemDriver_layout"
                style="@style/RendererSecondaryCard"
                android:layout_marginTop="@dimen/renderer_secondary_gap">

                <TextView
                    android:id="@+id/zinkPreferSystemDriver_title"
                    style="@style/RendererSettingTitle"
                    android:layout_toStartOf="@id/zinkPreferSystemDriver"
                    android:text="@string/setting_vulkan_driver_system_title" />

                <TextView
                    android:id="@+id/zinkPreferSystemDriver_summary"
                    style="@style/RendererSettingSummary"
                    android:layout_below="@id/zinkPreferSystemDriver_title"
                    android:layout_toStartOf="@id/zinkPreferSystemDriver"
                    android:text="@string/setting_vulkan_driver_system_desc" />

                <Switch
                    android:id="@+id/zinkPreferSystemDriver"
                    style="@style/RendererSettingSwitch" />
            </com.movtery.angkorlauncher.ui.layout.AnimRelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.core.widget.NestedScrollView>
