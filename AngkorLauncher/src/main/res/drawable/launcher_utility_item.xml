<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_14sdp" />
            <solid android:color="@color/launcher_disabled_overlay" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/glass_border_soft" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_14sdp" />
            <solid android:color="@color/launcher_glass_fill_pressed" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_14sdp" />
            <solid android:color="@color/launcher_glass_fill_pressed" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_14sdp" />
            <solid android:color="@color/launcher_glass_fill" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/glass_border_soft" />
        </shape>
    </item>
</selector>
