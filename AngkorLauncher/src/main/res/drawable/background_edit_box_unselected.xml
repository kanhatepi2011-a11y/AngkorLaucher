<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <gradient android:angle="270" android:startColor="@color/glass_surface_strong" android:endColor="@color/edit_box_fill" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/glass_border_soft" />
            <padding android:bottom="@dimen/padding_input_bottom" android:top="@dimen/padding_input_top" />
        </shape>
    </item>
    <item android:height="@dimen/_1sdp" android:gravity="top" android:left="@dimen/_5sdp" android:right="@dimen/_5sdp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
    <item android:drawable="?attr/selectableItemBackground" />
</layer-list>
