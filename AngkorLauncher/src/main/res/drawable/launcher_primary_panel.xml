<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/_2sdp"
        android:top="@dimen/_3sdp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_18sdp" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>

    <item
        android:right="@dimen/_2sdp"
        android:bottom="@dimen/_3sdp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_18sdp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_surface_strong"
                android:endColor="@color/download_panel_fill" />
            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/glass_border" />
        </shape>
    </item>

    <item
        android:height="@dimen/_1sdp"
        android:gravity="top"
        android:left="@dimen/_16sdp"
        android:right="@dimen/_16sdp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
