<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="@color/renderer_card_fill" android:endColor="@color/download_field_fill" />
            <stroke android:width="1dp" android:color="@color/renderer_border" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="10dp" android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
