<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/settings_rail_selected" />
            <stroke android:width="2dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="@color/settings_rail_selected" android:endColor="@color/glass_surface_selected" />
            <stroke android:width="1dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/glass_pressed" />
            <stroke android:width="1dp" android:color="@color/glass_highlight" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/glass_surface_strong" />
            <stroke android:width="2dp" android:color="@color/download_panel_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
