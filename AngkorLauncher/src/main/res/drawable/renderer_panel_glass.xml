<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/renderer_panel_radius" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/renderer_panel_radius" />
            <gradient
                android:angle="270"
                android:startColor="@color/renderer_panel_fill"
                android:endColor="@color/download_field_fill" />
            <stroke android:width="1dp" android:color="@color/renderer_border" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="24dp" android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
