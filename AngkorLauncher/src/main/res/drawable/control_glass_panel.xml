<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/control_panel_radius" />
            <solid android:color="@color/control_panel_shadow" />
        </shape>
    </item>
    <item android:bottom="4dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/control_panel_radius" />
            <gradient
                android:angle="270"
                android:startColor="@color/control_panel_fill"
                android:endColor="@color/control_panel_fill_strong" />
            <stroke android:width="1dp" android:color="@color/control_panel_border" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top"
        android:left="22dp"
        android:right="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_panel_highlight" />
        </shape>
    </item>
</layer-list>
