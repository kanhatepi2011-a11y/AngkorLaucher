<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/launcher_disabled_overlay" />
            <stroke android:width="1dp" android:color="@color/glass_border_soft" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/renderer_card_fill_pressed" />
            <stroke android:width="2dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/renderer_card_fill" />
            <stroke android:width="2dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="@color/renderer_card_fill" android:endColor="@color/download_field_fill" />
            <stroke android:width="1dp" android:color="@color/renderer_border" />
        </shape>
    </item>
</selector>
