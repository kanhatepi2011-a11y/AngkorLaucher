<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="@dimen/_2sdp">
        <shape android:shape="oval">
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item android:bottom="@dimen/_2sdp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_surface_strong"
                android:endColor="@color/glass_toolbar_end" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/glass_border" />
        </shape>
    </item>
</layer-list>
