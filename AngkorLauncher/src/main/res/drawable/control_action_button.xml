<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/control_disabled" />
            <stroke android:width="1dp" android:color="@color/glass_border_soft" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/control_item_pressed" />
            <stroke android:width="2dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/control_item_selected" />
            <stroke android:width="2dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/control_item_selected"
                android:endColor="@color/control_item_fill" />
            <stroke android:width="1dp" android:color="@color/control_panel_border" />
        </shape>
    </item>
</selector>
