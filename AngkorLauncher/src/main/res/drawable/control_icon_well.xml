<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/control_panel_shadow" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/control_item_selected"
                android:endColor="@color/control_item_fill" />
            <stroke android:width="1dp" android:color="@color/control_panel_border" />
        </shape>
    </item>
</layer-list>
