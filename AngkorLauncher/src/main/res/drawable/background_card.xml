<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft depth under the translucent panel. -->
    <item android:top="@dimen/_2sdp" android:left="@dimen/_1sdp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>

    <!-- Main glass body: warm enough to preserve the Angkor palette. -->
    <item android:bottom="@dimen/_2sdp" android:right="@dimen/_1sdp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_10sdp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_surface_strong"
                android:endColor="@color/glass_surface" />
            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/glass_border" />
        </shape>
    </item>

    <!-- Specular highlight that gives the iOS-like liquid edge. -->
    <item
        android:height="@dimen/_1sdp"
        android:gravity="top"
        android:left="@dimen/_6sdp"
        android:right="@dimen/_7sdp"
        android:top="@dimen/_1sdp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_1sdp" />
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
