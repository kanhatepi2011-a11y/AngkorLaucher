<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_4sdp" />
            <solid android:color="@color/glass_surface_subtle" />
            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/glass_border_soft" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/_4sdp" />
                <solid android:color="@color/glass_surface_selected" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/_4sdp" />
                <gradient
                    android:angle="0"
                    android:startColor="#B88916"
                    android:endColor="#E9CD68" />
            </shape>
        </clip>
    </item>
</layer-list>
