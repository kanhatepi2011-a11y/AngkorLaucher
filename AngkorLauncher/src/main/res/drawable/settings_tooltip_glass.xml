<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/glass_shadow" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="@color/renderer_gold_fill" android:endColor="@color/settings_rail_selected" />
            <stroke android:width="1dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top" android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_highlight" />
        </shape>
    </item>
</layer-list>
