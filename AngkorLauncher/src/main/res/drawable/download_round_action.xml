<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/glass_pressed" />
            <stroke android:width="1dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/glass_surface_strong" />
            <stroke android:width="2dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/download_panel_fill" android:endColor="@color/download_field_fill" />
            <stroke android:width="1dp" android:color="@color/download_panel_border" />
        </shape>
    </item>
</selector>
