<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/control_inner_radius" />
            <solid android:color="@color/control_item_selected" />
            <stroke android:width="1dp" android:color="@color/launcher_accent_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/control_inner_radius" />
            <gradient
                android:angle="270"
                android:startColor="@color/control_item_fill"
                android:endColor="@color/control_panel_fill_strong" />
            <stroke android:width="1dp" android:color="@color/control_panel_border" />
        </shape>
    </item>
</selector>
